# ---- MAYSAN INT. GROUP — Unified HR Platform + Appraisal (server) ----
# Copy to ".env" or set as host environment variables.

PORT=3000
HR_ADMIN_PASSCODE=056023          # single login for HR + Appraisal (change in production)

# Central database (MySQL). When set, ALL data — Excel snapshots, users, rules,
# job mapping, audit, appraisals, performance reviews and evaluation links — is
# saved to MySQL automatically and durably. Without it, the app falls back to
# JSON files on disk (fine locally; use a persistent volume on a server).
# Provide EITHER a URL:
# DATABASE_URL=mysql://user:password@host:3306/maysan
# OR discrete vars:
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=maysan
# MYSQL_PASSWORD=change-me
# MYSQL_DATABASE=maysan
