# ---- MAYSAN Appraisal server configuration ----
# Copy to ".env" (or set these as host environment variables) before deploy.

# HTTP port (host platforms usually set PORT automatically)
PORT=8090

# Access codes (CHANGE THESE IN PRODUCTION)
APPRAISAL_ADMIN_PIN=056023
APPRAISAL_STAFF_PIN=1234

# ---- Central database (MySQL) ----
# Provide EITHER a single URL:
# DATABASE_URL=mysql://user:password@host:3306/maysan_appraisal
# OR the discrete variables:
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=maysan
# MYSQL_PASSWORD=change-me
# MYSQL_DATABASE=maysan_appraisal
#
# If NO MySQL is configured, the server automatically falls back to a JSON
# file store (data/appraisal-db.json), which is perfect for a single server
# but is NOT shared across multiple instances.
# APPRAISAL_DATA_DIR=./data
